# Porta HTTP da API
PORTA=3333

# Provedor do banco: "sqlite" (padrão, local) ou "supabase" (a implementar)
PROVEDOR_BANCO=sqlite
CAMINHO_SQLITE=./dados/gota.db

# Supabase (usado quando PROVEDOR_BANCO=supabase)
SUPABASE_URL=
SUPABASE_CHAVE_SERVICO=

# Autenticação
JWT_SEGREDO=troque-este-segredo
JWT_EXPIRACAO=7d

# Fuso horário fixo do Brasil (Brasília, sem horário de verão) em minutos
FUSO_HORARIO_MINUTOS=-180

# Regras de negócio
# Dispositivo é considerado offline após X minutos sem leitura (documento: 12 h = 720).
# Na demonstração, use um valor baixo (ex.: 1) para mostrar o alerta rapidamente.
LIMITE_OFFLINE_MINUTOS=720
INTERVALO_VERIFICACAO_OFFLINE_SEGUNDOS=30
# Leituras com confiança do OCR abaixo deste valor são recusadas
CONFIANCA_MINIMA=0.8

# Chave fixa do dispositivo de demonstração criado pela carga inicial
CHAVE_DISPOSITIVO_DEMO=gota-demo-chave-001

CORS_ORIGEM=*
